  "ignore": [
    "docs/**",
    "CHANGELOG.md",
    "README.md",
    "openspec/changes/**",
    ".claude/commands/**",
    ".claude/skills/openspec-*/**",
    ".claude/skills/repo-wiki/**",
    ".claude/skills/harness-*/**",
    "reference/**",
    "**/*.pak",
    "**/*.png",
    "**/*.jpg",
    "harness/tools/s[0-9]*",
    "harness/tools/spike*",
    "harness/scenarios/probe_*.py"
  ],
  "commit_types": {"pattern": "^(?P<type>\\w+)(\\([^)]*\\))?!?:", "feat": ["feat"], "fix": ["fix"]},
  "capabilities_dir": "openspec/specs",
  "runs": {
    "glob": "runs/*/summary.json",
    "fields": {"time": "started", "test": "scenario", "verdict": "verdict", "commit": "git"},
    "pass": ["pass"],
    "fail": ["fail", "crash", "timeout"],
    "test_files": {
      "globs": ["harness/scenarios/*.py", "mod/*/scenarios/**/*.py"],
      "name_pattern": "^NAME\\s*=\\s*[\"']([^\"']+)[\"']",
      "stem_replace": ["_", "-"]
    }
  },
  "cfr": {"window_days": 14},
  "low_sample_n": 3,
  "thresholds": {"cfr": 0.3, "flaky": 0.2, "min_samples": 5, "unmapped_churn": 0.15},
  "report_dir": "docs/reliability"
}
